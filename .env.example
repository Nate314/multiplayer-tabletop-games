# Optional settings the app reads. None are required; the defaults are shown. See README.md for what each one does.
# run.sh / run.ps1 write the host port (APP_PORT) to .env themselves, so this file is only a reference.

# Server (npm start)
# PORT=3000
# SHOW_OPEN_GAMES=false
# PUSH_CONTACT=mailto:admin@localhost
# DATABASE_PATH=data/games.sqlite

# Client build (npm run build): the default game server for a static host such as GitHub Pages
# VITE_BACKEND_URL=
